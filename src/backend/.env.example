# =========================================
# 🚀 Server Configuration
# =========================================
PORT=5000
NODE_ENV=development

# =========================================
# 🗄️ Supabase Database Configuration (Session Pooler)
# =========================================
# ⚠️ UPDATED: Using the Pooler Host from your screenshot
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=

# ⚠️ UPDATED: The pooler requires this long username
SUPABASE_DB_USER=

# ⚠️ Password remains the same as your Direct connection
SUPABASE_DB_PASSWORD=

# SSL is required
SUPABASE_DB_SSL=true
#  JWT Authentication
JWT_SECRET=
JWT_EXPIRE=24h
# Optional: Full Connection String for reference
DATABASE_URL=
# =========================================
# ✉️ Gmail Email Service Configuration
# =========================================
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# =========================================
# 📂 Google Drive Service Account
# =========================================
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=